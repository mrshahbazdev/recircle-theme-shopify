{%- comment -%}
  Full-size wishlist button (PDP).
  Accepts: product
{%- endcomment -%}

<button type="button"
        class="wishlist-button"
        data-wishlist-toggle
        data-product-handle="{{ product.handle }}"
        data-product-id="{{ product.id }}"
        aria-pressed="false">
  <svg width="18" height="18" aria-hidden="true" focusable="false"><use href="#icon-heart"/></svg>
  <span data-wishlist-label>{{ 'recircle.wishlist.add' | t }}</span>
</button>
