{%- comment -%}
  Phase 17 — Analytics bootstrap (loaded in <head>).
  Initialises:
    - dataLayer (always; harmless if no provider configured)
    - Google Analytics 4 (gtag.js) when settings.ga4_id is set
    - Meta / Facebook Pixel when settings.meta_pixel_id is set
    - Optional consent-mode v2 default (denied) until visitor accepts
  Custom storefront events are dispatched from assets/analytics.js after DOM ready.
{%- endcomment -%}

{%- if settings.ga4_id != blank or settings.meta_pixel_id != blank -%}
  <script>
    window.dataLayer = window.dataLayer || [];
    window.gtag = window.gtag || function(){ dataLayer.push(arguments); };

    {%- if settings.consent_mode_default_denied -%}
    /* Consent Mode v2 — default denied; theme.js will update once visitor accepts */
    gtag('consent', 'default', {
      'ad_storage': 'denied',
      'ad_user_data': 'denied',
      'ad_personalization': 'denied',
      'analytics_storage': 'denied',
      'wait_for_update': 500
    });
    {%- endif -%}

    window.recircleAnalytics = {
      ga4Id: {{ settings.ga4_id | json }},
      metaPixelId: {{ settings.meta_pixel_id | json }},
      currency: {{ cart.currency.iso_code | json }},
      shopDomain: {{ shop.domain | json }},
      customerId: {%- if customer -%}{{ customer.id | json }}{%- else -%}null{%- endif -%},
      consentMode: {{ settings.consent_mode_default_denied | json }},
      debug: {{ settings.analytics_debug | json }}
    };
  </script>

  {%- if settings.ga4_id != blank -%}
    <script async src="https://www.googletagmanager.com/gtag/js?id={{ settings.ga4_id }}"></script>
    <script>
      gtag('js', new Date());
      gtag('config', {{ settings.ga4_id | json }}, {
        send_page_view: true,
        currency: window.recircleAnalytics.currency,
        debug_mode: window.recircleAnalytics.debug
      });
    </script>
  {%- endif -%}

  {%- if settings.meta_pixel_id != blank -%}
    <script>
      !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
      n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
      document,'script','https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', {{ settings.meta_pixel_id | json }});
      fbq('track', 'PageView');
    </script>
    <noscript>
      <img height="1" width="1" style="display:none" alt=""
           src="https://www.facebook.com/tr?id={{ settings.meta_pixel_id }}&ev=PageView&noscript=1"/>
    </noscript>
  {%- endif -%}
{%- endif -%}
