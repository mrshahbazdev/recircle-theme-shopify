[
  {
    "name": "theme_info",
    "theme_name": "ReCircle",
    "theme_version": "0.2.0",
    "theme_author": "mrshahbazdev",
    "theme_documentation_url": "https://github.com/mrshahbazdev/recircle-theme-shopify#readme",
    "theme_support_email": "support@recircle-theme.com"
  },
  {
    "name": "Style presets",
    "settings": [
      {
        "type": "paragraph",
        "content": "Quick swap the entire look. Each preset overrides the individual colour and font settings below — clear the preset (\"None\") to fall back to the granular controls."
      },
      {
        "type": "select",
        "id": "palette_preset",
        "label": "Colour palette",
        "options": [
          { "value": "cream",     "label": "Cream (default — warm off-white + deep forest)" },
          { "value": "sand",      "label": "Sand (desert / muted ochre)" },
          { "value": "forest",    "label": "Forest (rich green + cream)" },
          { "value": "charcoal",  "label": "Charcoal (light text on charcoal cards)" },
          { "value": "midnight",  "label": "Midnight (dark mode, blue-black surfaces)" },
          { "value": "none",      "label": "None — use the granular colour controls below" }
        ],
        "default": "cream"
      },
      {
        "type": "select",
        "id": "font_preset",
        "label": "Typography preset",
        "options": [
          { "value": "editorial", "label": "Editorial (Playfair Display + Inter — default)" },
          { "value": "modern",    "label": "Modern (Manrope + Inter)" },
          { "value": "classic",   "label": "Classic (Georgia + system sans)" },
          { "value": "tech",      "label": "Tech (Space Grotesk + Inter)" },
          { "value": "none",      "label": "None — use the typography settings below" }
        ],
        "default": "editorial"
      },
      {
        "type": "select",
        "id": "density_preset",
        "label": "Layout density",
        "info": "Compact = tighter padding & smaller hero on collection / PDP. Comfortable = default.",
        "options": [
          { "value": "compact",     "label": "Compact" },
          { "value": "comfortable", "label": "Comfortable (default)" },
          { "value": "spacious",    "label": "Spacious (editorial showcase)" }
        ],
        "default": "comfortable"
      },
      {
        "type": "checkbox",
        "id": "honour_dark_mode",
        "label": "Honour visitor's OS dark-mode preference",
        "info": "When enabled, the storefront automatically flips to a dark palette on devices with prefers-color-scheme: dark. Independent of the palette preset above.",
        "default": true
      }
    ]
  },
  {
    "name": "t:settings_schema.colors.name",
    "settings": [
      {
        "type": "header",
        "content": "t:settings_schema.colors.headers.brand"
      },
      {
        "type": "color",
        "id": "color_brand",
        "label": "t:settings_schema.colors.labels.brand",
        "default": "#0E3B2C"
      },
      {
        "type": "color",
        "id": "color_brand_hover",
        "label": "Brand hover",
        "default": "#1B5B40"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent (CO₂ / sustainability)",
        "default": "#2E8659"
      },
      {
        "type": "color",
        "id": "color_amber",
        "label": "Highlight (warranty / badges)",
        "default": "#C8661B"
      },
      {
        "type": "header",
        "content": "Text & surfaces"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#0D211A"
      },
      {
        "type": "color",
        "id": "color_text_muted",
        "label": "Muted text",
        "default": "#6B7461"
      },
      {
        "type": "color",
        "id": "color_bg",
        "label": "Page background",
        "default": "#FBF8F3"
      },
      {
        "type": "color",
        "id": "color_bg_subtle",
        "label": "Subtle background",
        "default": "#F3EFE6"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Border",
        "default": "#E4DED1"
      },
      {
        "type": "header",
        "content": "Condition grades"
      },
      {
        "type": "color",
        "id": "color_grade_a",
        "label": "Grade A (Like-new)",
        "default": "#0F4D3A"
      },
      {
        "type": "color",
        "id": "color_grade_b",
        "label": "Grade B (Very good)",
        "default": "#2E8659"
      },
      {
        "type": "color",
        "id": "color_grade_c",
        "label": "Grade C (Good)",
        "default": "#F5A623"
      },
      {
        "type": "color",
        "id": "color_grade_d",
        "label": "Grade D (Fair)",
        "default": "#B45309"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_header_font",
        "label": "Heading font",
        "default": "playfair_display_n7"
      },
      {
        "type": "range",
        "id": "type_header_scale",
        "label": "Heading scale",
        "min": 100,
        "max": 150,
        "step": 5,
        "unit": "%",
        "default": 110
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body font",
        "default": "inter_n4"
      },
      {
        "type": "range",
        "id": "type_body_scale",
        "label": "Body scale",
        "min": 100,
        "max": 130,
        "step": 5,
        "unit": "%",
        "default": 100
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Page width",
        "min": 1000,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "default": 1280
      },
      {
        "type": "range",
        "id": "spacing_sections",
        "label": "Space between sections",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "default": 40
      },
      {
        "type": "select",
        "id": "corner_radius",
        "label": "Corner radius",
        "options": [
          { "value": "0", "label": "Sharp" },
          { "value": "6", "label": "Soft" },
          { "value": "12", "label": "Rounded" }
        ],
        "default": "12"
      }
    ]
  },
  {
    "name": "Refurbished & circular",
    "settings": [
      {
        "type": "header",
        "content": "Condition grading"
      },
      {
        "type": "checkbox",
        "id": "grading_enabled",
        "label": "Enable condition grading on product cards",
        "default": true
      },
      {
        "type": "text",
        "id": "grading_label_a",
        "label": "Grade A label",
        "default": "Like new"
      },
      {
        "type": "text",
        "id": "grading_label_b",
        "label": "Grade B label",
        "default": "Very good"
      },
      {
        "type": "text",
        "id": "grading_label_c",
        "label": "Grade C label",
        "default": "Good"
      },
      {
        "type": "text",
        "id": "grading_label_d",
        "label": "Grade D label",
        "default": "Fair"
      },
      {
        "type": "header",
        "content": "Sustainability"
      },
      {
        "type": "checkbox",
        "id": "co2_badge_enabled",
        "label": "Show CO₂ saved badge on products",
        "default": true
      },
      {
        "type": "text",
        "id": "co2_unit",
        "label": "CO₂ unit label",
        "default": "kg CO₂e saved vs buying new"
      },
      {
        "type": "header",
        "content": "EU compliance"
      },
      {
        "type": "checkbox",
        "id": "dpp_enabled",
        "label": "Show Digital Product Passport block on product pages",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "repairability_enabled",
        "label": "Show repairability score on product pages",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "price_indication_enabled",
        "label": "Show 30-day-low price (EU Price Indication Directive)",
        "info": "Uses product.metafields.recircle.price_30day_low",
        "default": true
      },
      {
        "type": "header",
        "content": "Warranty & returns"
      },
      {
        "type": "text",
        "id": "warranty_months",
        "label": "Default warranty (months)",
        "default": "12"
      },
      {
        "type": "text",
        "id": "returns_days_eu",
        "label": "Default EU return window (days)",
        "default": "14"
      }
    ]
  },
  {
    "name": "Premium add-ons",
    "settings": [
      {
        "type": "header",
        "content": "Wishlist"
      },
      {
        "type": "checkbox",
        "id": "wishlist_enabled",
        "label": "Enable wishlist (heart on product cards)",
        "default": true,
        "info": "Stored locally per shopper. Page template: page.wishlist."
      },
      {
        "type": "header",
        "content": "Quick view"
      },
      {
        "type": "checkbox",
        "id": "quickview_enabled",
        "label": "Enable quick-view modal on product cards",
        "default": true,
        "info": "Fetches /products/<handle>?section_id=main-quick-view."
      },
      {
        "type": "header",
        "content": "Compare"
      },
      {
        "type": "checkbox",
        "id": "compare_enabled",
        "label": "Enable product compare",
        "default": true,
        "info": "Up to 4 items. Page template: page.compare."
      },
      {
        "type": "range",
        "id": "compare_max",
        "label": "Max items in compare tray",
        "min": 2,
        "max": 6,
        "step": 1,
        "default": 4
      },
      {
        "type": "header",
        "content": "Recently viewed"
      },
      {
        "type": "checkbox",
        "id": "recently_viewed_enabled",
        "label": "Track recently-viewed products",
        "default": true,
        "info": "Add the \"Recently viewed\" section to any template to display the rail."
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok URL"
      },
      {
        "type": "text",
        "id": "social_linkedin",
        "label": "LinkedIn URL"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "YouTube URL"
      }
    ]
  },
  {
    "name": "Favicon & logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo width",
        "min": 60,
        "max": 260,
        "step": 10,
        "unit": "px",
        "default": 130
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Analytics",
    "settings": [
      {
        "type": "paragraph",
        "content": "Plug-and-play GA4 + Meta Pixel. Both are optional — leave blank to disable. Custom storefront events (wishlist add, compare, trade-in quote, quick-view) fire automatically when the matching feature is enabled."
      },
      {
        "type": "header",
        "content": "Google Analytics 4"
      },
      {
        "type": "text",
        "id": "ga4_id",
        "label": "GA4 Measurement ID",
        "info": "e.g. G-XXXXXXXXXX. Leave blank to disable.",
        "default": ""
      },
      {
        "type": "header",
        "content": "Meta (Facebook) Pixel"
      },
      {
        "type": "text",
        "id": "meta_pixel_id",
        "label": "Meta Pixel ID",
        "info": "Numeric pixel ID from Meta Events Manager. Leave blank to disable.",
        "default": ""
      },
      {
        "type": "header",
        "content": "Privacy & consent"
      },
      {
        "type": "checkbox",
        "id": "consent_mode_default_denied",
        "label": "Default consent to denied (GA4 Consent Mode v2)",
        "info": "Recommended for EU markets. Storefront calls window.recircleAnalytics.grantConsent() after the visitor accepts your cookie banner.",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "analytics_debug",
        "label": "Debug mode (log every event to the JS console)",
        "info": "Useful while wiring up. Disable in production.",
        "default": false
      },
      {
        "type": "header",
        "content": "Cookie consent banner"
      },
      {
        "type": "checkbox",
        "id": "consent_banner_enabled",
        "label": "Show cookie consent banner",
        "info": "Renders only when at least one analytics provider is configured above. Persists choice to localStorage and grants/revokes Consent Mode v2 + Meta Pixel accordingly.",
        "default": true
      },
      {
        "type": "url",
        "id": "consent_policy_link",
        "label": "Privacy / cookie policy URL",
        "info": "Link rendered as 'Learn more' inside the banner. Leave blank to hide."
      }
    ]
  },
  {
    "name": "Subscription & loyalty",
    "settings": [
      {
        "type": "header",
        "content": "Subscriptions"
      },
      {
        "type": "paragraph",
        "content": "Connect a subscription app (Shopify Subscriptions, Recharge, Skio, Loop, etc.) and attach a Selling Plan group to your products. The PDP picker auto-renders when at least one selling-plan allocation is present."
      },
      {
        "type": "header",
        "content": "Member pricing"
      },
      {
        "type": "checkbox",
        "id": "member_pricing_enabled",
        "label": "Enable member pricing",
        "default": false
      },
      {
        "type": "text",
        "id": "member_tag",
        "label": "Member customer tag",
        "info": "Customers tagged with this value see member pricing.",
        "default": "member"
      },
      {
        "type": "range",
        "id": "member_discount_percent",
        "label": "Default member discount %",
        "min": 0,
        "max": 50,
        "step": 1,
        "default": 10,
        "info": "Per-product overrides via product metafield recircle.member_price (number) take precedence."
      },
      {
        "type": "checkbox",
        "id": "member_pricing_teaser",
        "label": "Show teaser pill to non-members on PDP",
        "default": true
      },
      {
        "type": "header",
        "content": "ReCircle Credits (loyalty)"
      },
      {
        "type": "paragraph",
        "content": "Credits balances are read from the customer metafield recircle.credits_balance (number). History is read from recircle.credits_history (json: [{date,type,amount,note}]). Wire your loyalty app or Shopify Flow to keep these up to date."
      }
    ]
  },
  {
    "name": "B2B / wholesale",
    "settings": [
      {
        "type": "checkbox",
        "id": "b2b_enabled",
        "label": "Enable B2B features",
        "info": "When on, B2B-tagged customers see tiered pricing on PDPs and tag-locked sections unlock for them.",
        "default": false
      },
      {
        "type": "text",
        "id": "b2b_tags",
        "label": "B2B customer tags (comma-separated)",
        "info": "Any one of these tags grants B2B access. Add tags to customers in Shopify Admin → Customers.",
        "default": "b2b,wholesale"
      },
      {
        "type": "header",
        "content": "Per-product overrides"
      },
      {
        "type": "paragraph",
        "content": "Tiered pricing → product metafield recircle.b2b_tiers (json: [{min_qty, price}, …]). Minimum order quantity → product metafield recircle.moq (number). Documented in docs/B2B-WHOLESALE.md."
      }
    ]
  }
]
