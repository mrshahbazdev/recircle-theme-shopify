<section class="section" aria-labelledby="fc-heading-{{ section.id }}">
  <div class="page-width">
    <header class="section-heading flex items-center justify-between" style="flex-direction:row;align-items:flex-end">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="section-heading__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="section-heading__title" id="fc-heading-{{ section.id }}">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.collection != blank -%}
        <a href="{{ collections[section.settings.collection].url }}" class="btn btn--link">{{ 'collections.general.view_all' | t }} →</a>
      {%- endif -%}
    </header>

    <div class="product-row">
      {%- assign coll = collections[section.settings.collection] -%}
      {%- if coll.products.size > 0 -%}
        {%- for product in coll.products limit: section.settings.product_limit -%}
          {% render 'product-card', product: product, show_vendor: section.settings.show_vendor %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.product_limit) -%}
          <article class="product-card">
            <div class="product-card__media">
              <div style="width:100%;height:100%;background:var(--color-bg-subtle);display:flex;align-items:center;justify-content:center;color:var(--color-text-muted);font-size:0.8rem">[ Sample ]</div>
            </div>
            <h3 class="product-card__title">Sample refurbished product #{{ i }}</h3>
            <div class="product-card__meta">
              <div class="product-card__price">€{{ 199 | plus: forloop.index0 | times: 40 }}</div>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Featured" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bestsellers" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "product_limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": true }
  ],
  "presets": [ { "name": "Featured collection" } ]
}
{% endschema %}
