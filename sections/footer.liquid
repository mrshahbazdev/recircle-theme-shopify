<footer class="site-footer" role="contentinfo">
  <div class="page-width">
    <div class="site-footer__grid">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          {%- case block.type -%}

            {%- when 'menu' -%}
              <h4>{{ block.settings.heading }}</h4>
              <ul>
                {%- for link in linklists[block.settings.menu].links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>

            {%- when 'newsletter' -%}
              <h4>{{ block.settings.heading }}</h4>
              <p style="margin:0 0 1rem;font-size:0.9rem;color:var(--color-text-muted)">{{ block.settings.body }}</p>
              {%- if block.settings.klaviyo_list_id != blank -%}
                <form class="newsletter-form footer-newsletter-form"
                      action="https://manage.kmail-lists.com/ajax/subscriptions/subscribe"
                      method="post"
                      novalidate
                      data-klaviyo-form>
                  <input type="hidden" name="g" value="{{ block.settings.klaviyo_list_id }}">
                  <div style="display:flex;gap:0.5rem">
                    <input type="email" name="email" required autocomplete="email"
                           placeholder="{{ 'recircle.newsletter.placeholder' | t }}"
                           aria-label="{{ 'recircle.newsletter.label' | t }}" style="flex:1">
                    <button type="submit" class="btn btn--primary">{{ 'recircle.newsletter.submit' | t }}</button>
                  </div>
                  <p data-newsletter-success hidden style="color:var(--color-accent);margin-top:0.75rem">
                    {{ 'recircle.newsletter.success' | t }}
                  </p>
                  <p data-newsletter-error hidden style="color:#8B2F2F;margin-top:0.75rem">
                    {{ 'recircle.newsletter.error' | t }}
                  </p>
                </form>
              {%- else -%}
                {%- form 'customer', class: 'newsletter-form footer-newsletter-form' -%}
                  <input type="hidden" name="contact[tags]" value="newsletter">
                  <div style="display:flex;gap:0.5rem">
                    <input type="email" name="contact[email]" required autocomplete="email"
                           placeholder="{{ 'recircle.newsletter.placeholder' | t }}"
                           aria-label="{{ 'recircle.newsletter.label' | t }}" style="flex:1">
                    <button type="submit" class="btn btn--primary">{{ 'recircle.newsletter.submit' | t }}</button>
                  </div>
                  {%- if form.posted_successfully? -%}
                    <p style="color:var(--color-accent);margin-top:0.75rem">{{ 'recircle.newsletter.success' | t }}</p>
                  {%- endif -%}
                {%- endform -%}
              {%- endif -%}

            {%- when 'text' -%}
              {%- if block.settings.heading != blank -%}<h4>{{ block.settings.heading }}</h4>{%- endif -%}
              <div style="font-size:0.9rem;color:var(--color-text)">{{ block.settings.body }}</div>

            {%- when 'social' -%}
              <h4>{{ block.settings.heading | default: 'Follow us' }}</h4>
              <ul style="flex-direction:row">
                {%- if settings.social_instagram != blank -%}<li><a href="{{ settings.social_instagram }}" rel="me noopener">Instagram</a></li>{%- endif -%}
                {%- if settings.social_tiktok != blank -%}<li><a href="{{ settings.social_tiktok }}" rel="me noopener">TikTok</a></li>{%- endif -%}
                {%- if settings.social_linkedin != blank -%}<li><a href="{{ settings.social_linkedin }}" rel="me noopener">LinkedIn</a></li>{%- endif -%}
                {%- if settings.social_youtube != blank -%}<li><a href="{{ settings.social_youtube }}" rel="me noopener">YouTube</a></li>{%- endif -%}
              </ul>

          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.show_locale_selector -%}
      <div class="site-footer__locale">
        {% render 'locale-selector', location: 'footer', layout: 'inline',
                  show_country: section.settings.show_country_selector,
                  show_language: section.settings.show_language_selector %}
      </div>
    {%- endif -%}

    <div class="site-footer__bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Refurbished with care. </p>
      <p>
        {%- if settings.consent_banner_enabled and (settings.ga4_id != blank or settings.meta_pixel_id != blank) -%}
          <button type="button" class="site-footer__consent-link" data-consent-open>
            {{ 'recircle.consent.manage' | t }}
          </button>
        {%- endif -%}
        {%- if shop.enabled_payment_types.size > 0 -%}
          {%- for type in shop.enabled_payment_types -%}
            <span style="margin-right:0.4rem">{{ type | payment_type_svg_tag: class: 'payment-icon' }}</span>
          {%- endfor -%}
        {%- endif -%}
      </p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "checkbox", "id": "show_locale_selector",   "label": "Show country / language selector", "default": true },
    { "type": "checkbox", "id": "show_country_selector",  "label": "Country & currency",               "default": true },
    { "type": "checkbox", "id": "show_language_selector", "label": "Language",                          "default": true }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Join the circular economy" },
        { "type": "text", "id": "body", "label": "Body", "default": "Monthly drops, price alerts, and sustainability news." },
        { "type": "text", "id": "klaviyo_list_id", "label": "Klaviyo list ID (optional)",
          "info": "Found in Klaviyo → Lists & Segments → list URL. Leave blank to fall back to a Shopify customer with the tag 'newsletter'." }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "richtext", "id": "body", "label": "Body" }
      ]
    },
    {
      "type": "social",
      "name": "Social links",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Follow us" }
      ]
    }
  ],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
