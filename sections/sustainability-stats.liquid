<section class="section" aria-labelledby="ss-heading-{{ section.id }}">
  <div class="page-width">
    <header class="section-heading text-center" style="margin-inline:auto">
      {%- if section.settings.eyebrow != blank -%}<p class="section-heading__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 id="ss-heading-{{ section.id }}" class="section-heading__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="section-heading__text">{{ section.settings.text }}</p>{%- endif -%}
    </header>

    <div class="stats-strip">
      {%- for block in section.blocks -%}
        {%- if block.type == 'stat' -%}
          <div {{ block.shopify_attributes }}>
            <span class="stats-strip__value">{{ block.settings.value }}</span>
            <span class="stats-strip__label">{{ block.settings.label }}</span>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sustainability stats",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our impact" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Numbers that matter" },
    { "type": "textarea", "id": "text", "label": "Text" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "50k+" },
        { "type": "text", "id": "label", "label": "Label", "default": "Devices refurbished" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Sustainability stats",
      "blocks": [
        { "type": "stat", "settings": { "value": "50,000+", "label": "Devices refurbished" } },
        { "type": "stat", "settings": { "value": "482 t", "label": "CO₂e saved" } },
        { "type": "stat", "settings": { "value": "99.2%", "label": "Working after 1 year" } },
        { "type": "stat", "settings": { "value": "4.8/5", "label": "Customer rating" } }
      ]
    }
  ]
}
{% endschema %}
