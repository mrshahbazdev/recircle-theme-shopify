<section class="section editorial-page search-page" aria-label="Search">
  <div class="page-width">
    <header class="editorial-page__header editorial-page__header--centered">
      <div class="editorial-page__heading-group">
        <p class="editorial-page__eyebrow">
          <svg width="14" height="14" aria-hidden="true" focusable="false"><use href="#icon-search"/></svg>
          <span>{{ section.settings.eyebrow | default: 'Search the shop' }}</span>
        </p>
        <h1 class="editorial-page__heading">
          {%- if search.performed -%}
            {%- if search.results_count > 0 -%}
              Results for &ldquo;{{ search.terms | escape }}&rdquo;
            {%- else -%}
              Nothing for &ldquo;{{ search.terms | escape }}&rdquo;
            {%- endif -%}
          {%- else -%}
            What are you looking for?
          {%- endif -%}
        </h1>
        {%- if search.performed -%}
          <p class="editorial-page__meta">{{ search.results_count }} results</p>
        {%- endif -%}
      </div>
    </header>

    <form action="{{ routes.search_url }}" method="get" role="search" class="search-bar">
      <label for="search-input" class="visually-hidden">{{ 'general.search.submit' | t }}</label>
      <input id="search-input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}" autofocus>
      <button type="submit" class="button button--primary">{{ 'general.search.submit' | t }}</button>
    </form>

    {%- if search.performed -%}
      {%- if search.results_count == 0 -%}
        <div class="editorial-empty">
          <div class="editorial-empty__icon" aria-hidden="true">
            <svg width="30" height="30"><use href="#icon-search"/></svg>
          </div>
          <h2 class="editorial-empty__title">No matches yet</h2>
          <p class="editorial-empty__body">{{ 'general.search.no_results_html' | t: terms: search.terms }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="button button--primary editorial-empty__cta">Browse everything</a>
        </div>
      {%- else -%}
        <div class="collection-grid">
          {%- paginate search.results by 24 -%}
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {% render 'product-card', product: item %}
              {%- elsif item.object_type == 'article' -%}
                <article class="article-card">
                  {%- if item.image -%}
                    <a href="{{ item.url }}" class="article-card__media">
                      <img src="{{ item.image | image_url: width: 600 }}"
                           srcset="{{ item.image | image_url: width: 400 }} 400w, {{ item.image | image_url: width: 700 }} 700w, {{ item.image | image_url: width: 1000 }} 1000w"
                           sizes="(min-width: 900px) 320px, 90vw"
                           alt="{{ item.title | escape }}"
                           width="600" height="400"
                           loading="lazy" decoding="async">
                    </a>
                  {%- endif -%}
                  <div class="article-card__body">
                    <p class="article-card__meta">Journal</p>
                    <h3 class="article-card__title"><a href="{{ item.url }}">{{ item.title }}</a></h3>
                  </div>
                </article>
              {%- else -%}
                <article class="article-card">
                  <div class="article-card__body">
                    <p class="article-card__meta">{{ item.object_type }}</p>
                    <h3 class="article-card__title"><a href="{{ item.url }}">{{ item.title }}</a></h3>
                  </div>
                </article>
              {%- endif -%}
            {%- endfor -%}
          {%- endpaginate -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Search results",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Search the shop" }
  ],
  "enabled_on": { "templates": ["search"] }
}
{% endschema %}
