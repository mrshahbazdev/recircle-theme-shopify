<section class="section">
  <div class="page-width" style="max-width:460px">
    <h1>{{ 'customer.login.title' | t }}</h1>
    {%- form 'customer_login', novalidate: 'novalidate' -%}
      {%- if form.errors -%}
        <p style="color:#c00">{{ form.errors | default_errors }}</p>
      {%- endif -%}
      <div class="field">
        <label for="CustomerEmail" class="field__label">{{ 'customer.login.email' | t }}</label>
        <input type="email" id="CustomerEmail" name="customer[email]" autocomplete="email" required>
      </div>
      <div class="field" style="margin-top:0.75rem">
        <label for="CustomerPassword" class="field__label">{{ 'customer.login.password' | t }}</label>
        <input type="password" id="CustomerPassword" name="customer[password]" autocomplete="current-password" required>
      </div>
      <div style="display:flex;justify-content:space-between;align-items:center;margin-top:1rem">
        <a href="{{ routes.account_recover_url }}" class="btn btn--link">{{ 'customer.login.forgot_password' | t }}</a>
        <button type="submit" class="btn btn--primary">{{ 'customer.login.sign_in' | t }}</button>
      </div>
    {%- endform -%}

    <p style="margin-top:2rem;text-align:center">
      <a href="{{ routes.account_register_url }}" class="btn btn--link">{{ 'customer.login.create_account' | t }}</a>
    </p>

    {%- form 'recover_customer_password' -%}
      {%- if form.posted_successfully? -%}
        <p style="color:var(--color-accent);margin-top:1rem">We've sent you an email with a link to reset your password.</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Login", "tag": "section", "settings": [] }
{% endschema %}
