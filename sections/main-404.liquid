<section class="section text-center">
  <div class="page-width" style="max-width:640px">
    <h1 style="font-size:clamp(3rem, 10vw, 6rem);margin:0 0 0.5em">404</h1>
    <h2>{{ 'general.404.title' | t }}</h2>
    <p style="color:var(--color-text-muted)">{{ 'general.404.subtext' | t }}</p>
    <a href="{{ routes.root_url }}" class="btn btn--primary" style="margin-top:1rem">{{ 'general.404.link' | t }}</a>
  </div>
</section>

{% schema %}
{ "name": "404", "tag": "section", "settings": [], "enabled_on": { "templates": ["404"] } }
{% endschema %}
