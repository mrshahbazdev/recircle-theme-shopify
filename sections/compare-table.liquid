<section class="section editorial-page compare-page" data-compare-root>
  <div class="page-width">
    <header class="editorial-page__header editorial-page__header--centered">
      <div class="editorial-page__heading-group">
        <p class="editorial-page__eyebrow">
          <svg width="14" height="14" aria-hidden="true"><use href="#icon-compare"/></svg>
          <span>{{ section.settings.eyebrow | default: 'Side by side' }}</span>
        </p>
        <h1 class="editorial-page__heading">{{ section.settings.heading | default: 'Compare refurbished products' }}</h1>
        {%- if section.settings.subheading != blank -%}
          <div class="editorial-page__subheading" style="margin:0 auto">{{ section.settings.subheading }}</div>
        {%- endif -%}
      </div>
    </header>

    <div class="editorial-empty" data-compare-empty>
      <div class="editorial-empty__icon" aria-hidden="true">
        <svg width="30" height="30"><use href="#icon-compare"/></svg>
      </div>
      <h2 class="editorial-empty__title">Nothing to compare yet</h2>
      <p class="editorial-empty__body">{{ 'recircle.compare.empty_body' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="button button--primary editorial-empty__cta">
        {{ 'recircle.compare.empty_cta' | t }}
        <svg width="14" height="14" aria-hidden="true"><use href="#icon-arrow-right"/></svg>
      </a>
    </div>

    <div class="compare-table-wrap" data-compare-wrap hidden>
      <table class="compare-table" data-compare-table>
        <caption class="visually-hidden">{{ section.settings.heading }}</caption>
        <thead>
          <tr data-compare-head></tr>
        </thead>
        <tbody data-compare-body></tbody>
      </table>

      <div class="compare-actions">
        <button type="button" class="button button--outline" data-compare-clear>
          <svg width="16" height="16" aria-hidden="true"><use href="#icon-trash"/></svg>
          {{ 'recircle.compare.clear' | t }}
        </button>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Compare",
  "settings": [
    { "type": "text",     "id": "eyebrow",    "label": "Eyebrow",    "default": "Side by side" },
    { "type": "text",     "id": "heading",    "label": "Heading",    "default": "Compare refurbished products" },
    { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>Side-by-side specs, condition grade, CO\u2082 savings and warranty.</p>" }
  ],
  "presets": [{ "name": "Compare" }]
}
{% endschema %}
