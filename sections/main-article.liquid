<article class="section article-page">
  <div class="page-width article-page__inner">
    <p class="article-page__eyebrow">
      <svg width="14" height="14" aria-hidden="true"><use href="#icon-leaf"/></svg>
      <span>{{ section.settings.eyebrow | default: 'Journal' }}</span>
    </p>
    <h1 class="article-page__title">{{ article.title }}</h1>
    <p class="article-page__byline">{{ article.published_at | date: '%b %d, %Y' }} · {{ article.author }}</p>

    {%- if article.image -%}
      <img
        class="article-page__hero"
        src="{{ article.image | image_url: width: 1600 }}"
        srcset="{{ article.image | image_url: width: 900 }} 900w, {{ article.image | image_url: width: 1400 }} 1400w, {{ article.image | image_url: width: 1800 }} 1800w"
        sizes="(min-width: 900px) 780px, 100vw"
        alt="{{ article.title | escape }}"
        width="1600" height="900"
        loading="eager" decoding="async"
        fetchpriority="high">
    {%- endif -%}

    <div class="article-page__body rte">{{ article.content }}</div>

    {%- if blog.comments_enabled? -%}
      <section class="editorial-panel editorial-panel--wide" style="margin-top:3rem">
        <h2 style="font-family:var(--font-heading-family);font-weight:500;margin:0 0 1.25rem">{{ 'blogs.comments.title' | t }}</h2>
        {%- if article.comments_count > 0 -%}
          {%- for comment in article.comments -%}
            <div style="border-top:1px solid var(--color-border);padding:1rem 0">
              <p style="font-weight:600;margin:0 0 0.15rem">{{ comment.author }}</p>
              <p style="color:var(--color-text-muted);font-size:0.82rem;letter-spacing:0.04em;margin:0 0 0.5rem">{{ comment.created_at | date: '%b %d, %Y' }}</p>
              <div>{{ comment.content }}</div>
            </div>
          {%- endfor -%}
        {%- endif -%}
        {%- form 'new_comment', article -%}
          <div class="field">
            <label class="field__label" for="ArticleCommentName">{{ 'blogs.comments.name' | t }}</label>
            <input type="text" id="ArticleCommentName" name="comment[author]" required>
          </div>
          <div class="field">
            <label class="field__label" for="ArticleCommentEmail">{{ 'blogs.comments.email' | t }}</label>
            <input type="email" id="ArticleCommentEmail" name="comment[email]" required>
          </div>
          <div class="field">
            <label class="field__label" for="ArticleCommentBody">{{ 'blogs.comments.message' | t }}</label>
            <textarea id="ArticleCommentBody" name="comment[body]" rows="5" required></textarea>
          </div>
          <div class="editorial-panel__footer">
            <button type="submit" class="button button--primary">{{ 'blogs.comments.post' | t }}</button>
          </div>
        {%- endform -%}
      </section>
    {%- endif -%}
  </div>
</article>

{% schema %}
{
  "name": "Article",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Journal" }
  ],
  "enabled_on": { "templates": ["article"] }
}
{% endschema %}
