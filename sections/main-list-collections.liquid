{%- liquid
  assign sort = section.settings.sort | default: 'alphabetical'
  if sort == 'products_high'
    assign list = collections | sort: 'products_count' | reverse
  elsif sort == 'date'
    assign list = collections | sort: 'published_at' | reverse
  else
    assign list = collections | sort: 'title'
  endif
-%}

<section class="section list-collections" role="region" aria-labelledby="ListCollectionsHeading">
  <div class="page-width">
    <header class="section__head">
      <h1 id="ListCollectionsHeading" class="section__title">{{ section.settings.heading | default: 'All collections' }}</h1>
    </header>

    {%- if list.size == 0 -%}
      <p>{{ 'general.search.no_results' | t | default: 'No collections yet.' }}</p>
    {%- else -%}
      <ul class="collection-list" role="list">
        {%- for col in list -%}
          <li class="collection-list__item">
            <a href="{{ col.url }}" class="collection-list__link" aria-label="{{ col.title | escape }}">
              {%- if col.image -%}
                <img
                  srcset="{{ col.image | image_url: width: 300 }} 300w,
                          {{ col.image | image_url: width: 600 }} 600w,
                          {{ col.image | image_url: width: 900 }} 900w"
                  sizes="(min-width: 900px) 300px, 45vw"
                  src="{{ col.image | image_url: width: 600 }}"
                  alt="{{ col.image.alt | default: col.title | escape }}"
                  width="{{ col.image.width }}"
                  height="{{ col.image.height }}"
                  loading="lazy"
                  decoding="async">
              {%- else -%}
                <div class="collection-list__placeholder" aria-hidden="true"></div>
              {%- endif -%}
              <span class="collection-list__title">{{ col.title }}</span>
              <span class="collection-list__count">{{ col.products_count }} {{ 'general.products' | t | default: 'products' }}</span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "tag": "section",
  "class": "section-list-collections",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "All collections" },
    {
      "type": "select", "id": "sort", "label": "Sort by",
      "options": [
        { "value": "alphabetical", "label": "Alphabetical" },
        { "value": "products_high", "label": "Most products" },
        { "value": "date", "label": "Newest" }
      ],
      "default": "alphabetical"
    }
  ]
}
{% endschema %}
