{%- liquid
  assign sort = section.settings.sort | default: 'alphabetical'
  if sort == 'products_high'
    assign list = collections | sort: 'products_count' | reverse
  elsif sort == 'date'
    assign list = collections | sort: 'published_at' | reverse
  else
    assign list = collections | sort: 'title'
  endif
-%}

<section class="section editorial-page list-collections" role="region" aria-labelledby="ListCollectionsHeading">
  <div class="page-width">
    <header class="editorial-page__header editorial-page__header--centered">
      <div class="editorial-page__heading-group">
        <p class="editorial-page__eyebrow">
          <svg width="14" height="14" aria-hidden="true"><use href="#icon-leaf"/></svg>
          <span>{{ section.settings.eyebrow | default: 'Shop by category' }}</span>
        </p>
        <h1 id="ListCollectionsHeading" class="editorial-page__heading">{{ section.settings.heading | default: 'All collections' }}</h1>
        {%- if section.settings.subheading != blank -%}
          <div class="editorial-page__subheading" style="margin:0 auto">{{ section.settings.subheading }}</div>
        {%- endif -%}
      </div>
    </header>

    {%- if list.size == 0 -%}
      <div class="editorial-empty">
        <div class="editorial-empty__icon" aria-hidden="true">
          <svg width="30" height="30"><use href="#icon-leaf"/></svg>
        </div>
        <p class="editorial-empty__body">{{ 'general.search.no_results' | t | default: 'No collections yet.' }}</p>
      </div>
    {%- else -%}
      <ul class="collection-list" role="list">
        {%- for col in list -%}
          <li class="collection-list__item">
            <a href="{{ col.url }}" class="collection-list__link" aria-label="{{ col.title | escape }}">
              {%- if col.image -%}
                <img
                  srcset="{{ col.image | image_url: width: 400 }} 400w,
                          {{ col.image | image_url: width: 700 }} 700w,
                          {{ col.image | image_url: width: 1000 }} 1000w"
                  sizes="(min-width: 900px) 300px, 45vw"
                  src="{{ col.image | image_url: width: 700 }}"
                  alt="{{ col.image.alt | default: col.title | escape }}"
                  width="{{ col.image.width }}"
                  height="{{ col.image.height }}"
                  loading="lazy"
                  decoding="async">
              {%- else -%}
                <div class="collection-list__placeholder" aria-hidden="true"></div>
              {%- endif -%}
              <span class="collection-list__title">{{ col.title }}</span>
              <span class="collection-list__count">{{ col.products_count }} {{ 'general.products' | t | default: 'products' }}</span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "tag": "section",
  "class": "section-list-collections",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by category" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "All collections" },
    { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>Explore refurbished electronics, fashion and furniture — all with transparent grading.</p>" },
    {
      "type": "select", "id": "sort", "label": "Sort by",
      "options": [
        { "value": "alphabetical", "label": "Alphabetical" },
        { "value": "products_high", "label": "Most products" },
        { "value": "date", "label": "Newest" }
      ],
      "default": "alphabetical"
    }
  ]
}
{% endschema %}
