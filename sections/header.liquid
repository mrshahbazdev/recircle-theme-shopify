<header class="site-header" data-header>
  <div class="page-width site-header__inner">
    <button type="button"
            class="site-header__menu-toggle"
            data-menu-toggle
            aria-expanded="false"
            aria-controls="SiteNav"
            aria-label="{{ 'accessibility.menu' | t | default: 'Menu' }}">
      <svg width="22" height="22" aria-hidden="true"><use href="#icon-menu"/></svg>
    </button>

    <a href="{{ routes.root_url }}" class="site-header__logo">
      {%- if settings.logo != blank -%}
        <img src="{{ settings.logo | image_url: width: settings.logo_width | times: 2 }}"
             alt="{{ shop.name }}"
             width="{{ settings.logo_width }}"
             height="auto"
             loading="eager"
             decoding="async"
             fetchpriority="high">
      {%- else -%}
        <span class="site-header__logo-mark" aria-hidden="true">R</span>
        <span>{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <nav id="SiteNav" class="site-nav" aria-label="Primary" data-site-nav>
      {%- for link in linklists[section.settings.menu].links -%}
        {%- assign matching_panel = nil -%}
        {%- for blk in section.blocks -%}
          {%- if blk.type == 'mega_menu' and blk.settings.linked_link == link.handle -%}
            {%- assign matching_panel = blk -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if matching_panel -%}
          <div class="site-nav__item site-nav__item--has-mega" data-mega-item>
            <a href="{{ link.url }}"
               class="site-nav__link"
               {% if link.active %}aria-current="page"{% endif %}
               aria-haspopup="true"
               aria-expanded="false"
               data-mega-trigger>
              {{ link.title }}
              <svg class="site-nav__chev" width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                <path d="m2.5 3.75 2.5 2.5 2.5-2.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
            <div class="mega-menu" role="region" aria-label="{{ link.title }} menu" hidden data-mega-panel>
              <div class="page-width mega-menu__inner">
                {%- if matching_panel.settings.heading != blank -%}
                  <p class="mega-menu__eyebrow">{{ matching_panel.settings.heading }}</p>
                {%- endif -%}
                <div class="mega-menu__grid">
                  {%- for col_handle in (1..4) -%}
                    {%- liquid
                      assign col_title_key = 'col' | append: col_handle | append: '_title'
                      assign col_link_key  = 'col' | append: col_handle | append: '_linklist'
                      assign col_title = matching_panel.settings[col_title_key]
                      assign col_links_handle = matching_panel.settings[col_link_key]
                      assign col_links = linklists[col_links_handle].links
                    -%}
                    {%- if col_title != blank or col_links.size > 0 -%}
                      <div class="mega-menu__col">
                        {%- if col_title != blank -%}
                          <p class="mega-menu__col-title">{{ col_title }}</p>
                        {%- endif -%}
                        {%- if col_links.size > 0 -%}
                          <ul class="mega-menu__col-list">
                            {%- for sub in col_links -%}
                              <li><a href="{{ sub.url }}" class="mega-menu__col-link">{{ sub.title }}</a></li>
                            {%- endfor -%}
                          </ul>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  {%- endfor -%}

                  {%- if matching_panel.settings.feature_product != blank -%}
                    {%- assign feat = all_products[matching_panel.settings.feature_product] -%}
                    {%- if feat and feat != empty -%}
                      <a href="{{ feat.url }}" class="mega-menu__feature">
                        {%- if feat.featured_image -%}
                          <img src="{{ feat.featured_image | image_url: width: 320 }}"
                               alt="{{ feat.title | escape }}"
                               width="160" height="160"
                               loading="lazy" decoding="async">
                        {%- endif -%}
                        <span class="mega-menu__feature-meta">
                          <span class="mega-menu__feature-eyebrow">{{ matching_panel.settings.feature_eyebrow | default: 'Featured' }}</span>
                          <span class="mega-menu__feature-title">{{ feat.title }}</span>
                          <span class="mega-menu__feature-price">
                            {%- if feat.compare_at_price > feat.price -%}
                              <span class="mega-menu__feature-now">{{ feat.price | money }}</span>
                              <span class="mega-menu__feature-was">{{ feat.compare_at_price | money }}</span>
                            {%- else -%}
                              <span class="mega-menu__feature-now">{{ feat.price | money }}</span>
                            {%- endif -%}
                            {%- assign grade = feat.metafields.recircle.grade -%}
                            {%- if grade -%}<span class="mega-menu__feature-pill">Grade {{ grade }}</span>{%- endif -%}
                          </span>
                        </span>
                      </a>
                    {%- endif -%}
                  {%- elsif matching_panel.settings.feature_image != blank -%}
                    <a href="{{ matching_panel.settings.feature_link | default: '#' }}" class="mega-menu__feature mega-menu__feature--image">
                      <img src="{{ matching_panel.settings.feature_image | image_url: width: 480 }}"
                           alt="{{ matching_panel.settings.feature_title | escape }}"
                           width="240" height="240"
                           loading="lazy" decoding="async">
                      {%- if matching_panel.settings.feature_title != blank -%}
                        <span class="mega-menu__feature-meta">
                          <span class="mega-menu__feature-eyebrow">{{ matching_panel.settings.feature_eyebrow | default: 'Spotlight' }}</span>
                          <span class="mega-menu__feature-title">{{ matching_panel.settings.feature_title }}</span>
                        </span>
                      {%- endif -%}
                    </a>
                  {%- endif -%}
                </div>
              </div>
            </div>
          </div>
        {%- else -%}
          <a href="{{ link.url }}" class="site-nav__link" {% if link.active %}aria-current="page"{% endif %}>{{ link.title }}</a>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    <div class="site-header__actions">
      {%- if section.settings.show_search -%}
        <button type="button"
                class="site-header__icon-btn"
                data-search-toggle
                aria-expanded="false"
                aria-controls="PredictiveSearch"
                aria-label="{{ 'general.search.submit' | t }}">
          <svg width="20" height="20" aria-hidden="true"><use href="#icon-search"/></svg>
        </button>
      {%- endif -%}

      {%- if section.settings.show_country_selector and localization.available_countries.size > 1 -%}
        <form method="post" action="/localization" id="HeaderCountryForm" accept-charset="UTF-8" enctype="multipart/form-data" class="site-header__loc-form">
          <input type="hidden" name="_method" value="put">
          <input name="return_to" type="hidden" value="{{ request.path }}">
          <label for="HeaderCountrySelect" class="visually-hidden">{{ 'general.localization.country_label' | t }}</label>
          <select id="HeaderCountrySelect" name="country_code" class="site-header__country" onchange="this.form.submit()" aria-label="{{ 'general.localization.country_label' | t }}">
            {%- for country in localization.available_countries -%}
              <option value="{{ country.iso_code }}"
                      {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>
                {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
              </option>
            {%- endfor -%}
          </select>
        </form>
      {%- endif -%}

      {%- if section.settings.show_language_selector and localization.available_languages.size > 1 -%}
        <form method="post" action="/localization" id="HeaderLanguageForm" accept-charset="UTF-8" enctype="multipart/form-data" class="site-header__loc-form">
          <input type="hidden" name="_method" value="put">
          <input name="return_to" type="hidden" value="{{ request.path }}">
          <label for="HeaderLanguageSelect" class="visually-hidden">{{ 'general.localization.language_label' | t }}</label>
          <select id="HeaderLanguageSelect" name="locale_code" class="site-header__language" onchange="this.form.submit()" aria-label="{{ 'general.localization.language_label' | t }}">
            {%- for language in localization.available_languages -%}
              <option value="{{ language.iso_code }}" lang="{{ language.iso_code }}"
                      {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>
                {{ language.endonym_name | capitalize }}
              </option>
            {%- endfor -%}
          </select>
        </form>
      {%- endif -%}

      {%- if settings.wishlist_enabled and section.settings.show_wishlist -%}
        <a href="/pages/wishlist" class="site-header__icon-btn" aria-label="{{ 'recircle.wishlist.title' | t }}">
          <svg width="20" height="20" aria-hidden="true"><use href="#icon-heart"/></svg>
          <span class="cart-count-bubble" data-wishlist-count hidden>0</span>
        </a>
      {%- endif -%}

      {%- if section.settings.show_account -%}
        <a href="{{ routes.account_url }}" class="site-header__icon-btn" aria-label="{{ 'customer.account.title' | t }}">
          <svg width="20" height="20" aria-hidden="true"><use href="#icon-user"/></svg>
        </a>
      {%- endif -%}

      {%- if section.settings.show_cart -%}
        <button type="button"
                class="site-header__icon-btn"
                data-cart-toggle
                aria-label="{{ 'general.cart.title' | t }}"
                aria-controls="CartDrawer"
                aria-expanded="false">
          <svg width="20" height="20" aria-hidden="true"><use href="#icon-cart"/></svg>
          <span class="cart-count-bubble"
                data-cart-count
                {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
        </button>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.show_search -%}
    <div id="PredictiveSearch"
         class="predictive-search"
         role="search"
         hidden
         data-predictive-search>
      <div class="page-width predictive-search__wrap">
        <form action="{{ routes.search_url }}" method="get" class="predictive-search__form" role="search">
          <svg width="18" height="18" aria-hidden="true"><use href="#icon-search"/></svg>
          <label for="PredictiveSearchInput" class="visually-hidden">{{ 'general.search.placeholder' | t }}</label>
          <input type="search"
                 id="PredictiveSearchInput"
                 name="q"
                 placeholder="{{ 'general.search.placeholder' | t }}"
                 autocomplete="off"
                 autocorrect="off"
                 data-predictive-search-input
                 aria-controls="PredictiveSearchResults"
                 aria-activedescendant=""
                 aria-expanded="false">
          <button type="button"
                  class="predictive-search__close"
                  data-search-toggle
                  aria-label="{{ 'accessibility.close' | t }}">
            <svg width="16" height="16" aria-hidden="true"><use href="#icon-close"/></svg>
          </button>
        </form>
        <div data-predictive-search-target aria-live="polite"></div>
      </div>
    </div>
  {%- endif -%}
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "checkbox", "id": "show_search", "label": "Show search", "default": true },
    { "type": "checkbox", "id": "show_account", "label": "Show account icon", "default": true },
    { "type": "checkbox", "id": "show_wishlist", "label": "Show wishlist icon", "default": true },
    { "type": "checkbox", "id": "show_cart", "label": "Show cart icon", "default": true },
    { "type": "checkbox", "id": "show_country_selector", "label": "Show country/currency selector", "default": true },
    { "type": "checkbox", "id": "show_language_selector", "label": "Show language selector", "default": true }
  ],
  "blocks": [
    {
      "type": "mega_menu",
      "name": "Mega menu panel",
      "settings": [
        { "type": "paragraph", "content": "Each panel attaches to one top-level link in your main menu by handle (e.g. shop, refurbished, brands)." },
        { "type": "text", "id": "linked_link", "label": "Top-level link handle", "info": "Find this in Navigation. e.g. \"shop\" for a link titled Shop." },
        { "type": "text", "id": "heading", "label": "Panel eyebrow", "default": "Browse" },
        { "type": "header", "content": "Columns" },
        { "type": "text", "id": "col1_title", "label": "Column 1 title", "default": "By category" },
        { "type": "link_list", "id": "col1_linklist", "label": "Column 1 links" },
        { "type": "text", "id": "col2_title", "label": "Column 2 title", "default": "By brand" },
        { "type": "link_list", "id": "col2_linklist", "label": "Column 2 links" },
        { "type": "text", "id": "col3_title", "label": "Column 3 title", "default": "By grade" },
        { "type": "link_list", "id": "col3_linklist", "label": "Column 3 links" },
        { "type": "text", "id": "col4_title", "label": "Column 4 title" },
        { "type": "link_list", "id": "col4_linklist", "label": "Column 4 links" },
        { "type": "header", "content": "Spotlight" },
        { "type": "text", "id": "feature_eyebrow", "label": "Spotlight eyebrow", "default": "Featured" },
        { "type": "product", "id": "feature_product", "label": "Featured product (optional)" },
        { "type": "image_picker", "id": "feature_image", "label": "Or featured image" },
        { "type": "text", "id": "feature_title", "label": "Image caption" },
        { "type": "url", "id": "feature_link", "label": "Image link" }
      ]
    }
  ],
  "max_blocks": 6,
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
