<section class="section" aria-label="Blog">
  <div class="page-width">
    <h1>{{ blog.title }}</h1>
    <div class="collection-grid">
      {%- paginate blog.articles by 12 -%}
        {%- for article in blog.articles -%}
          <article class="product-card">
            {%- if article.image -%}
              <div class="product-card__media">
                <a href="{{ article.url }}"><img src="{{ article.image | image_url: width: 600 }}" alt="{{ article.title | escape }}" loading="lazy"></a>
              </div>
            {%- endif -%}
            <h2 class="product-card__title"><a href="{{ article.url }}">{{ article.title }}</a></h2>
            <p class="product-card__attrs">{{ article.published_at | date: '%b %d, %Y' }} · {{ article.author }}</p>
            {%- if article.excerpt_or_content != blank -%}
              <p style="font-size:0.9rem;color:var(--color-text-muted);margin:0">{{ article.excerpt_or_content | strip_html | truncatewords: 20 }}</p>
            {%- endif -%}
          </article>
        {%- endfor -%}
      {%- endpaginate -%}
    </div>
  </div>
</section>

{% schema %}
{ "name": "Blog posts", "tag": "section", "settings": [], "enabled_on": { "templates": ["blog"] } }
{% endschema %}
