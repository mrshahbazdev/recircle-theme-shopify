<section class="section">
  <div class="page-width" style="max-width:460px">
    <h1>{{ 'customer.reset_password.title' | t }}</h1>
    <p>{{ 'customer.reset_password.subtext' | t }}</p>
    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}<p style="color:#c00">{{ form.errors | default_errors }}</p>{%- endif -%}
      <div class="field"><label class="field__label" for="NewPwd">New password</label><input id="NewPwd" type="password" name="customer[password]" required></div>
      <div class="field" style="margin-top:0.75rem"><label class="field__label" for="ConfirmPwd">Confirm password</label><input id="ConfirmPwd" type="password" name="customer[password_confirmation]" required></div>
      <button type="submit" class="btn btn--primary" style="margin-top:1rem">{{ 'customer.reset_password.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Reset password", "tag": "section", "settings": [] }
{% endschema %}
