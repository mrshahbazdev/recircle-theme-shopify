<section class="section editorial-page" aria-label="Reset password">
  <div class="page-width">
    <header class="editorial-page__header editorial-page__header--centered" style="margin-bottom:2rem">
      <div class="editorial-page__heading-group">
        <p class="editorial-page__eyebrow">
          <svg width="14" height="14" aria-hidden="true"><use href="#icon-user"/></svg>
          <span>Account recovery</span>
        </p>
        <h1 class="editorial-page__heading" style="margin-bottom:0">{{ 'customer.reset_password.title' | t }}</h1>
        <p class="editorial-page__subheading" style="margin:0.85rem auto 0">{{ 'customer.reset_password.subtext' | t }}</p>
      </div>
    </header>

    <div class="editorial-panel">
      {%- form 'reset_customer_password' -%}
        {%- if form.errors -%}<p class="editorial-panel__error">{{ form.errors | default_errors }}</p>{%- endif -%}
        <div class="field">
          <label class="field__label" for="NewPwd">New password</label>
          <input id="NewPwd" type="password" name="customer[password]" required autocomplete="new-password">
        </div>
        <div class="field">
          <label class="field__label" for="ConfirmPwd">Confirm password</label>
          <input id="ConfirmPwd" type="password" name="customer[password_confirmation]" required autocomplete="new-password">
        </div>
        <div class="editorial-panel__footer">
          <a href="{{ routes.account_login_url }}" style="font-size:0.88rem;color:var(--color-text-muted)">Back to sign in</a>
          <button type="submit" class="button button--primary">{{ 'customer.reset_password.submit' | t }}</button>
        </div>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{ "name": "Reset password", "tag": "section", "settings": [] }
{% endschema %}
