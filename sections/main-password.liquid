<div class="password-page">
  <div class="password-card">
    <p class="password-card__eyebrow">{{ 'general.password_page.opening_soon' | t }}</p>
    <h1 style="font-family:var(--font-heading-family);font-weight:500;font-size:clamp(1.8rem,4vw,2.6rem);letter-spacing:-0.01em;margin:0 0 0.5rem">{{ shop.name }}</h1>
    {%- if section.settings.heading != blank -%}
      <p style="color:var(--color-text-muted);margin:0 0 1.5rem">{{ section.settings.heading }}</p>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="rte" style="color:var(--color-text-muted);margin:0 0 1.5rem;font-size:0.95rem">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- form 'storefront_password' -%}
      <div class="field" style="text-align:left">
        <label class="field__label" for="password">{{ 'general.password_page.login_form_password_label' | t }}</label>
        <input id="password" type="password" name="password"
               placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}"
               style="width:100%;padding:0.75em 0.9em;border:1px solid var(--color-border);border-radius:10px;background:var(--color-bg);font-size:1rem">
      </div>
      {%- if form.errors -%}
        <p class="editorial-panel__error" style="margin-top:0.75rem">{{ form.errors | default_errors }}</p>
      {%- endif -%}
      <button type="submit" class="button button--primary" style="width:100%;margin-top:1rem;padding:0.85em 1em">{{ 'general.password_page.login_form_submit' | t }}</button>
    {%- endform -%}

    <p style="margin-top:2rem;font-size:0.82rem;color:var(--color-text-muted)">
      {{ 'general.password_page.admin_link_html' | t }}
    </p>
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Coming soon" },
    { "type": "richtext", "id": "text", "label": "Text" }
  ]
}
{% endschema %}
