<div class="password-page__inner">
  <span class="site-header__logo-mark" aria-hidden="true" style="width:56px;height:56px;font-size:1.5rem;margin:0 auto 1rem">R</span>
  <h1>{{ shop.name }}</h1>
  <p style="color:var(--color-text-muted)">{{ 'general.password_page.opening_soon' | t }}</p>

  {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
  {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}

  {%- form 'storefront_password' -%}
    <label for="password" style="display:block;margin:1rem 0 0.5rem">{{ 'general.password_page.login_form_password_label' | t }}</label>
    <input id="password" type="password" name="password" placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}" style="max-width:300px;margin:0 auto;display:block">
    {%- if form.errors -%}
      <p style="color:#c00;margin-top:0.5rem">{{ form.errors | default_errors }}</p>
    {%- endif -%}
    <button type="submit" class="btn btn--primary" style="margin-top:1rem">{{ 'general.password_page.login_form_submit' | t }}</button>
  {%- endform -%}

  <p style="margin-top:2rem;font-size:0.85rem;color:var(--color-text-muted)">
    {{ 'general.password_page.admin_link_html' | t }}
  </p>
</div>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Coming soon" },
    { "type": "richtext", "id": "text", "label": "Text" }
  ]
}
{% endschema %}
