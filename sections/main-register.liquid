<section class="section">
  <div class="page-width" style="max-width:460px">
    <h1>{{ 'customer.register.title' | t }}</h1>
    {%- form 'create_customer' -%}
      {%- if form.errors -%}<p style="color:#c00">{{ form.errors | default_errors }}</p>{%- endif -%}
      <div class="field"><label class="field__label" for="FirstName">{{ 'customer.register.first_name' | t }}</label><input id="FirstName" type="text" name="customer[first_name]" autocomplete="given-name"></div>
      <div class="field" style="margin-top:0.75rem"><label class="field__label" for="LastName">{{ 'customer.register.last_name' | t }}</label><input id="LastName" type="text" name="customer[last_name]" autocomplete="family-name"></div>
      <div class="field" style="margin-top:0.75rem"><label class="field__label" for="RegEmail">{{ 'customer.login.email' | t }}</label><input id="RegEmail" type="email" name="customer[email]" required autocomplete="email"></div>
      <div class="field" style="margin-top:0.75rem"><label class="field__label" for="RegPassword">{{ 'customer.login.password' | t }}</label><input id="RegPassword" type="password" name="customer[password]" required autocomplete="new-password"></div>
      <button type="submit" class="btn btn--primary" style="margin-top:1rem">{{ 'customer.register.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Register", "tag": "section", "settings": [] }
{% endschema %}
