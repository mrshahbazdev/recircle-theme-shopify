{%- comment -%}
  Wishlist page. Renders a placeholder grid that is populated by JS at runtime
  from localStorage. Works entirely without Shopify customer accounts; if the
  customer IS logged in, the same list is mirrored to customer metafields via
  the Storefront API (optional enhancement).
{%- endcomment -%}

<section class="section wishlist-page" data-wishlist-root>
  <div class="page-width">
    <header class="section__header">
      <h1 class="section__heading">{{ section.settings.heading | default: 'Your wishlist' }}</h1>
      <p class="section__subheading" data-wishlist-subheading>{{ section.settings.subheading }}</p>
    </header>

    <div class="wishlist-empty" data-wishlist-empty>
      <p>{{ 'recircle.wishlist.empty_body' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="button button--primary">{{ 'recircle.wishlist.empty_cta' | t }}</a>
    </div>

    <div class="product-grid" data-wishlist-grid hidden>
      <!-- Cards injected by JS. -->
    </div>

    <div class="wishlist-actions" data-wishlist-actions hidden>
      <button type="button" class="button button--outline" data-wishlist-clear>
        <svg width="16" height="16" aria-hidden="true"><use href="#icon-trash"/></svg>
        {{ 'recircle.wishlist.clear' | t }}
      </button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Wishlist",
  "settings": [
    { "type": "text",     "id": "heading",    "label": "Heading",    "default": "Your wishlist" },
    { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>Refurbished picks you've saved for later. Stored locally on this device.</p>" }
  ],
  "presets": [{ "name": "Wishlist" }]
}
{% endschema %}
