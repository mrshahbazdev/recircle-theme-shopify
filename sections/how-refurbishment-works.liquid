<section class="section" aria-labelledby="refurb-heading-{{ section.id }}">
  <div class="page-width">
    <header class="section-heading">
      {%- if section.settings.eyebrow != blank -%}<p class="section-heading__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="section-heading__title" id="refurb-heading-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="section-heading__text">{{ section.settings.text }}</p>{%- endif -%}
    </header>

    <ol class="refurb-process" style="list-style:none;padding:0;margin:0">
      {%- for block in section.blocks -%}
        {%- if block.type == 'step' -%}
          <li class="refurb-step" {{ block.shopify_attributes }}>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.description }}</p>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "How refurbishment works",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our process" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From sourced to shipped — our 5-step process" },
    { "type": "textarea", "id": "text", "label": "Text" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Source" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "We source pre-owned devices from trade-ins, corporate fleets, and insurance returns." }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "How it works (5 steps)",
      "blocks": [
        { "type": "step", "settings": { "title": "Source", "description": "Pre-owned from trade-ins, corporate fleets, insurance returns." } },
        { "type": "step", "settings": { "title": "Inspect", "description": "50-point functional + cosmetic inspection by certified technicians." } },
        { "type": "step", "settings": { "title": "Repair", "description": "Genuine parts, batteries replaced where needed. Data wiped." } },
        { "type": "step", "settings": { "title": "Grade", "description": "Transparent A/B/C/D grading with photos of actual condition." } },
        { "type": "step", "settings": { "title": "Ship", "description": "Carbon-neutral shipping, 14-day returns, 12-month warranty." } }
      ]
    }
  ]
}
{% endschema %}
