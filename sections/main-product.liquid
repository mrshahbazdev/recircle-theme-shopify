<section class="section" aria-label="Product">
  <div class="page-width">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span class="breadcrumbs__sep">/</span>
      {%- if collection -%}
        <a href="{{ collection.url }}">{{ collection.title }}</a>
        <span class="breadcrumbs__sep">/</span>
      {%- endif -%}
      <span aria-current="page">{{ product.title }}</span>
    </nav>

    {%- assign buy_card_types = 'vendor,title,badges,price,variant_picker,buy_buttons,warranty_bar,wishlist,share' | split: ',' -%}
    {%- assign details_types  = 'repairability,dpp,description,before_after' | split: ',' -%}

    <div class="product-main" data-product-form-wrap data-product-handle="{{ product.handle }}">
      <div class="product-gallery-wrap">
        {% render 'product-gallery', product: product %}
      </div>

      <div class="product-info">
        {%- for block in section.blocks -%}
          {%- unless buy_card_types contains block.type -%}{%- continue -%}{%- endunless -%}
          {%- case block.type -%}

            {%- when 'vendor' -%}
              {%- if product.vendor != blank -%}
                <p class="product-info__vendor" {{ block.shopify_attributes }}>{{ product.vendor }}</p>
              {%- endif -%}

            {%- when 'title' -%}
              <h1 class="product-info__title" {{ block.shopify_attributes }}>{{ product.title }}</h1>

            {%- when 'badges' -%}
              <div class="product-info__badges" {{ block.shopify_attributes }}>
                {% render 'condition-badge', product: product %}
                {% render 'co2-badge', product: product, compact: false %}
              </div>

            {%- when 'price' -%}
              <div {{ block.shopify_attributes }}>
                {% render 'dual-price', product: product %}
              </div>

            {%- when 'variant_picker' -%}
              {%- if product.has_only_default_variant == false -%}
                <form class="variant-picker" {{ block.shopify_attributes }}>
                  {%- for option in product.options_with_values -%}
                    <fieldset style="border:none;padding:0;margin:0">
                      <legend class="variant-picker__legend">{{ option.name }}</legend>
                      <div class="variant-picker__options">
                        {%- for value in option.values -%}
                          <label class="variant-picker__option">
                            <input type="radio"
                                   name="option{{ option.position }}"
                                   value="{{ value | escape }}"
                                   {% if option.selected_value == value %}checked{% endif %}>
                            {{ value }}
                          </label>
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endfor -%}
                </form>
              {%- endif -%}

            {%- when 'buy_buttons' -%}
              {%- assign product_form_id = 'product-form-' | append: section.id -%}
              {% render 'member-price', product: product %}
              {% render 'b2b-tiered-pricing', product: product %}
              {%- form 'product', product, id: product_form_id, class: 'product-form', novalidate: 'novalidate' -%}
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                {% render 'subscription-options', product: product %}
                {%- assign moq = product.metafields.recircle.moq.value | default: 1 -%}
                <div class="product-form__quantity-wrap" style="margin-bottom:0.75rem">
                  <label for="Quantity-{{ section.id }}" class="visually-hidden">{{ 'products.product.quantity' | t }}</label>
                  <div class="product-form__quantity" data-quantity>
                    <button type="button" data-qty-step="-1" aria-label="{{ 'products.product.decrease_quantity' | t }}">−</button>
                    <input id="Quantity-{{ section.id }}" type="number" name="quantity" value="{{ moq }}" min="{{ moq }}" inputmode="numeric">
                    <button type="button" data-qty-step="1" aria-label="{{ 'products.product.increase_quantity' | t }}">+</button>
                  </div>
                  {% render 'b2b-moq', product: product, product_form_id: product_form_id %}
                </div>
                <div class="product-form__buttons">
                  <button type="submit"
                          class="btn btn--primary product-form__submit"
                          {% unless product.available %}disabled{% endunless %}>
                    {% if product.available %}
                      {{ 'products.product.add_to_cart' | t }}
                    {% else %}
                      {{ 'products.product.sold_out' | t }}
                    {% endif %}
                  </button>
                </div>
              {%- endform -%}

            {%- when 'warranty_bar' -%}
              <div {{ block.shopify_attributes }}>
                {% render 'warranty-bar', product: product %}
              </div>

            {%- when 'repairability' -%}
              <div {{ block.shopify_attributes }}>
                {% render 'repairability-score', product: product %}
              </div>

            {%- when 'dpp' -%}
              <div {{ block.shopify_attributes }}>
                {% render 'dpp-passport', product: product %}
              </div>

            {%- when 'description' -%}
              {%- if product.description != blank -%}
                <div {{ block.shopify_attributes }}>
                  <h2 style="font-size:1rem;margin-bottom:0.5rem">{{ 'products.product.description_title' | t }}</h2>
                  <div class="rte">{{ product.description }}</div>
                </div>
              {%- endif -%}

            {%- when 'before_after' -%}
              <div {{ block.shopify_attributes }} style="margin-top:1rem">
                <h2 style="font-size:1rem;margin-bottom:0.5rem">{{ 'products.refurbished.before_after_heading' | t }}</h2>
                {% render 'before-after-gallery', product: product %}
              </div>

            {%- when 'wishlist' -%}
              {%- if settings.wishlist_enabled -%}
                <div {{ block.shopify_attributes }} style="margin-top:0.75rem">
                  {% render 'wishlist-toggle', product: product %}
                </div>
              {%- endif -%}

            {%- when 'share' -%}
              <div class="flex gap-1" {{ block.shopify_attributes }} style="font-size:0.85rem;color:var(--color-text-muted)">
                <span>Share:</span>
                <a href="https://www.facebook.com/sharer.php?u={{ shop.url | append: product.url }}" target="_blank" rel="noopener">Facebook</a>
                <a href="https://twitter.com/share?url={{ shop.url | append: product.url }}&text={{ product.title | escape }}" target="_blank" rel="noopener">Twitter</a>
                <a href="mailto:?subject={{ product.title | escape }}&body={{ shop.url | append: product.url }}">Email</a>
              </div>

          {%- endcase -%}
        {%- endfor -%}
      </div>

      <div class="product-details">
        {%- for block in section.blocks -%}
          {%- unless details_types contains block.type -%}{%- continue -%}{%- endunless -%}
          {%- case block.type -%}

            {%- when 'repairability' -%}
              <div {{ block.shopify_attributes }}>
                {% render 'repairability-score', product: product %}
              </div>

            {%- when 'dpp' -%}
              <div {{ block.shopify_attributes }}>
                {% render 'dpp-passport', product: product %}
              </div>

            {%- when 'description' -%}
              {%- if product.description != blank -%}
                <div {{ block.shopify_attributes }}>
                  <h2 style="font-size:1rem;margin-bottom:0.5rem">{{ 'products.product.description_title' | t }}</h2>
                  <div class="rte">{{ product.description }}</div>
                </div>
              {%- endif -%}

            {%- when 'before_after' -%}
              <div {{ block.shopify_attributes }} style="margin-top:1rem">
                <h2 style="font-size:1rem;margin-bottom:0.5rem">{{ 'products.refurbished.before_after_heading' | t }}</h2>
                {% render 'before-after-gallery', product: product %}
              </div>

          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<div class="mobile-atc" data-mobile-atc aria-hidden="true">
  <span class="mobile-atc__price">{{ product.price | money }}</span>
  <a href="#Quantity-{{ section.id }}" class="btn btn--primary mobile-atc__cta">
    {% if product.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}
  </a>
</div>

{%- liquid
  assign structured_price = product.price | divided_by: 100.0
  assign variant = product.selected_or_first_available_variant
  assign reviews_count = product.metafields.reviews.rating_count.value | default: 0
  assign reviews_avg   = product.metafields.reviews.rating.value
  assign condition_grade = product.metafields.recircle.condition_grade.value
  assign gtin = variant.barcode
  assign mpn  = variant.sku
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  "image": [
    {%- for img in product.images limit: 5 -%}
      {{ img | image_url: width: 1600 | json }}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ],
  "description": {{ product.description | strip_html | truncatewords: 60 | json }},
  "sku": {{ mpn | json }},
  {%- if gtin != blank -%}"gtin": {{ gtin | json }},{%- endif -%}
  {%- if mpn  != blank -%}"mpn":  {{ mpn  | json }},{%- endif -%}
  "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
  "itemCondition": "https://schema.org/RefurbishedCondition",
  {%- if condition_grade != blank -%}
  "additionalProperty": [
    { "@type": "PropertyValue", "name": "Condition grade", "value": {{ condition_grade | json }} }
    {%- if product.metafields.recircle.repair_score.value -%},
    { "@type": "PropertyValue", "name": "Repairability score", "value": {{ product.metafields.recircle.repair_score.value | json }} }
    {%- endif -%}
    {%- if product.metafields.recircle.co2_saved_kg.value -%},
    { "@type": "PropertyValue", "name": "CO2 saved (kg)", "value": {{ product.metafields.recircle.co2_saved_kg.value | json }} }
    {%- endif -%}
  ],
  {%- endif -%}
  {%- if reviews_count != 0 and reviews_avg -%}
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": {{ reviews_avg | json }},
    "reviewCount": {{ reviews_count | json }}
  },
  {%- endif -%}
  "offers": {
    "@type": "Offer",
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "price": "{{ structured_price }}",
    "availability": "{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
    "url": {{ shop.url | append: product.url | json }},
    "itemCondition": "https://schema.org/RefurbishedCondition"
    {%- if product.metafields.recircle.warranty_months.value -%},
    "warranty": {
      "@type": "WarrantyPromise",
      "durationOfWarranty": {
        "@type": "QuantitativeValue",
        "value": {{ product.metafields.recircle.warranty_months.value | json }},
        "unitCode": "MON"
      }
    }
    {%- endif -%}
  }
}
</script>

{% schema %}
{
  "name": "Product information",
  "tag": "section",
  "blocks": [
    { "type": "@app" },
    { "type": "vendor",  "name": "Vendor", "limit": 1 },
    { "type": "title",   "name": "Title", "limit": 1 },
    { "type": "badges",  "name": "Condition & CO₂ badges", "limit": 1 },
    { "type": "price",   "name": "Price (dual EU-compliant)", "limit": 1 },
    { "type": "variant_picker", "name": "Variant picker", "limit": 1 },
    { "type": "buy_buttons",    "name": "Buy buttons", "limit": 1 },
    { "type": "warranty_bar",   "name": "Warranty bar", "limit": 1 },
    { "type": "repairability",  "name": "Repairability score", "limit": 1 },
    { "type": "dpp",            "name": "Digital Product Passport", "limit": 1 },
    { "type": "description",    "name": "Description", "limit": 1 },
    { "type": "before_after",   "name": "Before/after gallery", "limit": 1 },
    { "type": "wishlist",       "name": "Wishlist button", "limit": 1 },
    { "type": "share",          "name": "Share buttons", "limit": 1 }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
